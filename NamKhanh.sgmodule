#!name=Locket VIP & YouTube Premium
#!desc=Bản tự host và tối ưu mã nguồn bởi Hoàng Khánh Nam.
#!author=Hoang Khanh Nam (Original code: Duy Vinh & Contributors)

[Script]
# 1. Xóa Cache (Bắt buộc phải có để không kẹt hạng)
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/hknxyz08/test/main/header.js, timeout=60

# 2. Hack Locket Gold
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/hknxyz08/test/main/locket.js, requires-body=true, max-size=-1, timeout=60

# 3. Mở khóa Caption & Cài đặt Firebase (Chứa Đặc quyền Khánh Nam)
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/hknxyz08/test/main/firebase.js, requires-body=true, max-size=-1, timeout=60

# 4. Chặn quảng cáo YouTube Premium
youtube_ad = type=http-response, pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/player, script-path=https://raw.githubusercontent.com/hknxyz08/test/main/youtube.js, requires-body=true, max-size=-1, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, youtubei.googleapis.com, *.googlevideo.com, -redirector*.googlevideo.com
